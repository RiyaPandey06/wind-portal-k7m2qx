{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{data/**,backend/app/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.py" }]
}
